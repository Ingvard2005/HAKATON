# Existing AI implementation; migration to Qwen belongs to the AI module.
GEMINI_API_KEY=
# Server-side Bitrix24 incoming webhook, scope task.
BITRIX24_WEBHOOK_URL=
BITRIX24_RESPONSIBLE_ID=
# Optional explicit contact/deal binding, for example C_7 or D_10.
BITRIX24_CRM_BINDING=
# OAuth app installed in the selected portal: task and user access.
BITRIX24_CLIENT_ID=
BITRIX24_CLIENT_SECRET=
BITRIX24_TOKEN_FILE=data/bitrix24-token.json
# Optional ignored JSON with client_id, client_secret, portal_url and public_base.
BITRIX24_CREDENTIALS_FILE=credentials-bitrix24.json
# Separate Bitrix callback base; preserves a local Google Desktop callback.
BITRIX24_PUBLIC_BASE=
BITRIX24_PORTAL_URL=
# Local handler; public HTTPS reverse proxy is required for Bitrix24.
CALLMIND_OAUTH_PORT=8766
CALLMIND_OAUTH_PUBLIC_BASE=
GOOGLE_CREDENTIALS_FILE=credentials-google.json
GOOGLE_TOKEN_FILE=data/google-token.json
# API rejects every request until this secret is configured.
CALLMIND_API_KEY=
